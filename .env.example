# ===========================================
# API CONFIGURATION
# ===========================================

PROJECT_NAME=ZOKA-API
PROJECT_DESCRIPTION="Zoka API"
VERSION="1.0.0"
API_V1_STR="/api/v1"
DEBUG=True

# ===========================================
# DATABASE CONFIGURATION
# ===========================================

# PostgreSQL credentials
POSTGRES_USER=zoka
POSTGRES_PASSWORD=faso
POSTGRES_DB=zoka

# Database connection URL (format: postgresql+asyncpg://user:password@host:port/db)
DATABASE_URL=postgresql+asyncpg://zoka:faso@zoka-database:5432/zoka

# ===========================================
# SECURITY CONFIGURATION
# ===========================================

# Secret key used for JWT or password hashing
SECRET_KEY=your_secret_key_here

# Algorithm used for JWT tokens
ALGORITHM=HS256

# Token expiration in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ===========================================
# LOGGING CONFIGURATION
# ===========================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ===========================================
# CORS CONFIGURATION
# ===========================================

# Origins allowed to access the API (comma-separated or JSON array)
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://localhost:8080"]

# ===========================================
# OTHER OPTIONAL SETTINGS
# ===========================================

# Example: Environment type (development, staging, production)
ENVIRONMENT=development
