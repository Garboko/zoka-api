# Application
PROJECT_NAME="Zoka Data Collection API"
PROJECT_DESCRIPTION="API for mobile data collection with OpenRosa support"
VERSION="1.0.0"
ENVIRONMENT=development
API_V1_STR=/api/v1

# Logging
LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql://zoka_user:zoka_password@zoka-database:5432/zoka_db
DATABASE_USER=zoka_user
DATABASE_PASSWORD=zoka_password
DATABASE_NAME=zoka_db
DATABASE_HOST=zoka-database
DATABASE_DRIVER=pgsql

# Security
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# MinIO
MINIO_ENDPOINT=zoka-minio:9000
MINIO_EXTERNAL_ENDPOINT=localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=zoka-bucket
MINIO_USE_SSL=false
MINIO_DOMAIN=localhost

# Email (MailHog for development)
MAIL_SERVER=zoka-mailhog
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@zokatoolbox.com
MAIL_FROM_NAME="Zoka Platform"
MAIL_STARTTLS=false
MAIL_SSL_TLS=false
MAIL_USE_CREDENTIALS=false
MAIL_VALIDATE_CERTS=false

# Frontend
FRONTEND_URL=http://localhost:3000